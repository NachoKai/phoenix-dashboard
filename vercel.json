{
    "services": {
        "frontend": {
            "root": "frontend"
        },
        "backend": {
            "root": "backend",
            "framework": "express",
            "buildCommand": "npm run build",
            "outputDirectory": "dist",
            "devCommand": "npm run dev",
            "installCommand": "npm install"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}
